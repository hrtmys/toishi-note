#!/usr/bin/env bash
set -euo pipefail

# Samples job-wide memory use once a second (plan-opus.md §2.4). Not
# `/usr/bin/time -v`: that reports one process's max RSS, and the system
# tests exercise many Chrome processes at once. Run with `nohup ... &` so
# it survives across steps; the job-report step reads its output files.

out_dir="$1"
mkdir -p "$out_dir"
baseline_file="$out_dir/baseline_kb"
peak_file="$out_dir/peak_kb"
peak=0

while true; do
  read -r total available <<< "$(awk '/^MemTotal:/ { t = $2 } /^MemAvailable:/ { a = $2 } END { print t, a }' /proc/meminfo)"
  used=$((total - available))

  [ -f "$baseline_file" ] || echo "$used" > "$baseline_file"

  if [ "$used" -gt "$peak" ]; then
    peak=$used
    echo "$peak" > "$peak_file"
  fi

  sleep 1
done
