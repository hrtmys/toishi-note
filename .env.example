# Copy this file to .env and fill it in before running `docker compose up`.
# See docs/engineering/deployment.md for the full self-hosting guide.

# SECRET_KEY_BASE is required — the base secret behind every signed
# cookie/session. Recommended over RAILS_MASTER_KEY/config/credentials.yml.enc
# if you redeploy straight from a git pull (rather than a one-time build):
# a plain random value, generated once and kept only in this untracked
# .env, so a future `git pull` bringing in an updated/regenerated
# config/credentials.yml.enc (e.g. an upstream change to this template)
# can never invalidate your sessions or break your boot. Generate one with:
#
#   bin/rails secret
#
SECRET_KEY_BASE=

# IMPORTANT if you're using SECRET_KEY_BASE: do not also leave a
# config/master.key file sitting on disk unless you're certain it matches
# the config/credentials.yml.enc currently in the repo. SECRET_KEY_BASE
# only replaces *one* of the two things Rails reads credentials for —
# Active Record Encryption's own config is read independently at boot
# regardless of SECRET_KEY_BASE, and a *present but mismatched* key still
# crashes boot (a *missing* key file is fine and is silently skipped —
# it's specifically a stale, wrong one that's the problem). If you don't
# use RAILS_MASTER_KEY/config/master.key at all, just don't create the
# file, and SECRET_KEY_BASE alone is all this deployment ever needs.
#
# Want other secrets (SMTP credentials, etc.) managed the traditional
# Rails way, fully independent of this repo's shared default
# config/credentials.yml.enc? Use per-environment credentials instead —
# see docs/engineering/deployment.md's "Credentials" section.

# Required for password-reset and teammate-invite emails to contain a
# working link instead of https://example.com/... — set it to the domain
# you'll actually reach this deployment at. Not required if you only ever
# reset passwords from the console (see SECURITY.md) or use trusted-header
# auth instead.
APP_HOST=notes.example.org

# Defaults to https. Set to http only if you're genuinely not serving this
# over TLS anywhere (unusual — see docs/engineering/deployment.md).
# APP_PROTOCOL=https

# Optional. Set only if a trusted reverse proxy in front of this deployment
# (Cloudflare Access, Tailscale Serve, an nginx auth_request setup, ...) is
# configured to authenticate requests and set this header itself — see the
# warning comment on app/models/trusted_header_login.rb before enabling
# this. Leave unset for normal email/username + password login.
# TRUSTED_HEADER_AUTH_HEADER=Cf-Access-Authenticated-User-Email
