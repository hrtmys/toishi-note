# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore vendored gems.
/vendor/bundle

# Ignore all environment files.
/.env*
!/.env.example

# Deployment-specific Compose overrides (fixed container names, existing
# Docker networks, anything particular to one operator's infrastructure)
# — never the public template's job. See docker-compose.yml's own note
# and docker-compose.override.yml.example.
/docker-compose.override.yml

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key

# Per-environment credentials (config/credentials/<env>.yml.enc +
# config/credentials/<env>.key — see `bin/rails credentials:edit
# --environment production`) are how one specific deployment (e.g. a
# maintainer's own VPS) keeps secrets fully independent of this repo's
# shared config/credentials.yml.enc default — see
# docs/engineering/deployment.md. Neither file belongs in a public repo:
# the encrypted file is meaningless without its key, but it's still one
# specific deployment's own data, with nothing to gain from a git-backed
# copy (Rails' own credentials:edit output already says to save the key
# in a password manager instead).
/config/credentials/

/app/assets/builds/*
!/app/assets/builds/.keep

/node_modules

# Claude Code's own local/machine state — .claude/skills/ is checked in,
# this isn't.
/.claude/settings.local.json
/.claude/scheduled_tasks.lock

