<div class="modal fade" id="settingsModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content" data-controller="settings" data-settings-url-value="<%= settings_path %>">
      <div class="modal-header">
        <h5 class="modal-title"><%= t("settings.title") %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <%# Only as many tabs as have real content behind them — see the
          "Settings screen" note in ux-roadmap.md.old about not building tab
          chrome ahead of a feature that actually needs it. TODO/
          Integrations join once Phase 3/5 features actually land there. %>
      <ul class="nav nav-tabs px-3 pt-2" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#settingsEditorTab" type="button" role="tab" aria-selected="true">
            <%= t("settings.tabs.editor") %>
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" data-bs-toggle="tab" data-bs-target="#settingsAccountTab" type="button" role="tab" aria-selected="false">
            <%= t("settings.tabs.account") %>
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <%# Not run through t() — deliberately always English, same
              reasoning as the native-name radio labels inside this tab
              (see below): a language switcher needs to be findable by
              someone who can't yet read whatever locale the app is
              currently in. %>
          <button class="nav-link" data-bs-toggle="tab" data-bs-target="#settingsLanguageTab" type="button" role="tab" aria-selected="false">
            Language
          </button>
        </li>
      </ul>

      <div class="modal-body tab-content">
        <div class="tab-pane fade show active" id="settingsEditorTab" role="tabpanel">
          <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="editorFabToggle"
                data-action="change->settings#toggleFab"
                <%= "checked" if user.editor_fab_enabled? %>>
            <label class="form-check-label" for="editorFabToggle"><%= t("settings.editor.fab_label") %></label>
          </div>
          <p class="text-muted small mt-2 mb-0">
            <%= t("settings.editor.fab_description") %>
          </p>

          <hr>

          <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="compareToggle"
                data-action="change->settings#toggleCompare"
                <%= "checked" if user.compare_enabled? %>>
            <label class="form-check-label" for="compareToggle"><%= t("settings.editor.compare_label") %></label>
          </div>
          <p class="text-muted small mt-2 mb-0">
            <%= t("settings.editor.compare_description") %>
          </p>

          <hr>

          <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="tablePasteToggle"
                data-action="change->settings#toggleTablePaste"
                <%= "checked" if user.table_paste_enabled? %>>
            <label class="form-check-label" for="tablePasteToggle"><%= t("settings.editor.table_paste_label") %></label>
          </div>
          <p class="text-muted small mt-2 mb-0">
            <%= t("settings.editor.table_paste_description") %>
          </p>

          <hr>

          <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="keepOriginalImagesToggle"
                data-action="change->settings#toggleKeepOriginalImages"
                <%= "checked" if user.keep_original_images? %>>
            <label class="form-check-label" for="keepOriginalImagesToggle"><%= t("settings.editor.keep_original_images_label") %></label>
          </div>
          <p class="text-muted small mt-2 mb-0">
            <%= t("settings.editor.keep_original_images_description") %>
          </p>
        </div>

        <div class="tab-pane fade" id="settingsAccountTab" role="tabpanel">
          <p class="text-muted small mb-1"><%= t("settings.account.email_label") %></p>
          <p class="mb-3"><%= Current.user.email_address %></p>

          <% if trusted_header_auth? %>
            <%# No sign-out button here on purpose — see
                docs/product/ux-roadmap.md.old's Cloudflare Access notes:
                signing out and being signed back in on the very next
                request (the header is still vouching for you) would be
                the same thing, so a button that visibly does nothing is
                worse than no button. The notice says so explicitly,
                rather than just quietly omitting the button — a user
                who expects one and doesn't see it deserves an
                explanation, not a mystery. %>
            <p class="text-muted small mb-0">
              <%= t("settings.account.trusted_header_notice", mode: deployment_mode_label) %>
            </p>
          <% else %>
            <%= button_to t("home.sign_out"), session_path, method: :delete, class: "btn btn-sm btn-outline-secondary" %>
          <% end %>
        </div>

        <div class="tab-pane fade" id="settingsLanguageTab" role="tabpanel">
          <p class="text-muted small mb-3"><%= t("settings.language.description") %></p>

          <%# Each language's own name, in that language — a language
              switcher's labels are never run through the current locale's
              own t(), the same convention every other language picker
              (Wikipedia, GitHub, etc.) follows. %>
          <div class="form-check">
            <input class="form-check-input" type="radio" name="locale" id="localeEn" value="en"
                data-action="change->settings#changeLocale" <%= "checked" if user.locale == "en" %>>
            <label class="form-check-label" for="localeEn">English</label>
          </div>
          <div class="form-check">
            <input class="form-check-input" type="radio" name="locale" id="localeJa" value="ja"
                data-action="change->settings#changeLocale" <%= "checked" if user.locale == "ja" %>>
            <label class="form-check-label" for="localeJa">日本語</label>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
