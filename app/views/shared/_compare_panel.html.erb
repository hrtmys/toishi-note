<%# The Compare modal's contents — two independent Before/After text boxes,
    diffed live via compare_controller.js as either changes. No "baseline"
    concept: reached from the AI-formatting FAB's "Set as Before"/"Set as
    After" menu items (see compare_launcher_controller.js), which preload
    one side with the open note's current content before this shows, or
    just paste/type directly into either box. %>
<div class="row g-2">
  <div class="col-6 d-flex flex-column">
    <label class="form-label small text-muted mb-1" for="compareBefore"><%= t("compare.before_label") %></label>
    <textarea id="compareBefore" class="form-control flex-grow-1" rows="10" placeholder="<%= t("compare.before_placeholder") %>"
        data-compare-target="before" data-action="input->compare#render"></textarea>
  </div>

  <div class="col-6 d-flex flex-column">
    <label class="form-label small text-muted mb-1" for="compareAfter"><%= t("compare.after_label") %></label>
    <textarea id="compareAfter" class="form-control flex-grow-1" rows="10" placeholder="<%= t("compare.after_placeholder") %>"
        data-compare-target="after" data-action="input->compare#render"></textarea>
  </div>
</div>

<p data-compare-target="empty" class="text-muted small mt-3 mb-0">
  <i class="bi bi-info-circle"></i> <%= t("compare.empty") %>
</p>
<p data-compare-target="unchanged" class="text-muted small mt-3 mb-0 d-none">
  <i class="bi bi-info-circle"></i> <%= t("compare.unchanged") %>
</p>
<div data-compare-target="output" class="diff-output mt-2"></div>
