<div class="d-flex vh-100 justify-content-center align-items-center bg-light">
  <div class="card shadow-sm" style="width: 22rem;">
    <div class="card-body p-4">
      <h1 class="h4 mb-4 fw-bold"><%= t("passwords.edit_title") %></h1>

      <% if flash[:alert] %>
        <div class="alert alert-danger py-2 small"><%= flash[:alert] %></div>
      <% end %>

      <%= form_with url: password_path(params[:token]), method: :put do |f| %>
        <div class="mb-3">
          <%= f.label :password, t("passwords.new_password"), class: "form-label small" %>
          <%= f.password_field :password, class: "form-control", required: true, autocomplete: "new-password", maxlength: 72 %>
        </div>
        <div class="mb-4">
          <%= f.label :password_confirmation, t("passwords.confirm_new_password"), class: "form-label small" %>
          <%= f.password_field :password_confirmation, class: "form-control", required: true, autocomplete: "new-password", maxlength: 72 %>
        </div>
        <%= f.submit t("passwords.save"), class: "btn btn-primary w-100 mb-3" %>
      <% end %>

      <%= link_to t("passwords.back_to_sign_in"), new_session_path, class: "small" %>
    </div>
  </div>
</div>
