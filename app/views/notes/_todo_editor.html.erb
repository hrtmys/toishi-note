<div class="h-100 d-flex flex-column">
  <div class="d-flex justify-content-between align-items-center mb-1">
    <div class="flex-grow-1">
      <%= render partial: "todo_items/progress", locals: { note: note } %>
    </div>
    <% if Current.user.ai_handoff_enabled? %>
      <div class="form-check form-switch ms-2 mb-3" data-controller="ai-excluded-toggle" data-ai-excluded-toggle-note-id-value="<%= note.id %>">
        <input class="form-check-input" type="checkbox" role="switch" id="aiExcludedToggle"
            data-action="change->ai-excluded-toggle#toggle"
            <%= "checked" if note.ai_excluded? %>>
        <label class="form-check-label small text-nowrap" for="aiExcludedToggle"><%= t("home.todo.ai_excluded_label") %></label>
      </div>
    <% end %>
    <button type="button" class="btn btn-outline-secondary btn-sm ms-2 mb-3" data-bs-toggle="modal" data-bs-target="#bulk_import_modal_<%= note.id %>">
      <%= t("home.todo.bulk_add") %>
    </button>
  </div>
  <div id="todo_list_<%= note.id %>" class="flex-grow-1 overflow-y-auto overflow-x-hidden custom-scrollbar-light pe-2">
    <% note.todo_items.each do |item| %>
      <%= render partial: "todo_items/item", locals: { item: item } %>
    <% end %>
  </div>

  <div class="mt-3 bg-white p-2 rounded shadow-sm border flex-shrink-0">
    <%= form_with url: note_todo_items_path(note), method: :post,
        data: { controller: "reset-form", action: "turbo:submit-start->reset-form#submitStart turbo:submit-end->reset-form#submitEnd" } do |f| %>
      <div class="d-flex">
        <%= f.text_field :content, class: "form-control border-0", placeholder: t("home.todo.content_placeholder"), autofocus: true, autocomplete: "off", required: true, pattern: ".*\\S+.*", aria: { label: t("home.todo.content_placeholder") } %>
        <button type="button" class="btn btn-outline-secondary ms-2" data-bs-toggle="collapse" data-bs-target="#due_date_field_<%= note.id %>" title="<%= t("home.todo.add_due_date") %>">
          <i class="bi bi-calendar-plus"></i>
        </button>
        <%= f.submit t("home.common.add"), class: "btn btn-primary ms-2", data: { reset_form_target: "submit" } %>
      </div>
      <div id="due_date_field_<%= note.id %>" class="collapse mt-2">
        <%# Collapsed by default — a due date shouldn't feel obligatory. %>
        <%= f.date_field :due_date, class: "form-control form-control-sm", aria: { label: t("home.todo.due_date_label") } %>
      </div>
    <% end %>
  </div>

  <%= render partial: "todo_items/bulk_import_modal", locals: { note: note } %>
</div>
