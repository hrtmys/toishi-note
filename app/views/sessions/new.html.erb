<div class="d-flex vh-100 justify-content-center align-items-center bg-light">
  <div class="card shadow-sm" style="width: 22rem;">
    <div class="card-body p-4">
      <h1 class="h4 mb-3 fw-bold">Toishi Note</h1>

      <% if flash[:alert] %>
        <div class="alert alert-danger py-2 small"><%= flash[:alert] %></div>
      <% end %>
      <% if flash[:notice] %>
        <div class="alert alert-success py-2 small"><%= flash[:notice] %></div>
      <% end %>

      <%= form_with url: session_path do |f| %>
        <div class="mb-3">
          <%= f.label :email_address, t("auth.email_or_username"), class: "form-label small" %>
          <%= f.text_field :email_address, class: "form-control", required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
        </div>
        <div class="mb-4">
          <%= f.label :password, class: "form-label small" %>
          <%= f.password_field :password, class: "form-control", required: true, autocomplete: "current-password", maxlength: 72 %>
        </div>
        <%= f.submit t("sessions.sign_in"), class: "btn btn-primary w-100 mb-3" %>
      <% end %>

      <%= link_to t("sessions.forgot_password"), new_password_path, class: "small" %>
    </div>
  </div>
</div>
