<!-- A normal sidebar on desktop, an off-canvas slide-in on narrower/mobile viewports. -->
<div class="offcanvas-lg offcanvas-start col-lg-3 col-xl-2 bg-dark text-white p-0 h-100 d-flex flex-column" tabindex="-1" id="sidebarMenu" aria-labelledby="sidebarMenuLabel" data-controller="offcanvas">
  <div class="p-3 d-flex flex-column h-100">
    <div class="d-flex justify-content-between align-items-center mb-3 shrink-0">
      <%= link_to "Toishi Note", root_path(organize: true, notebook_id: current_notebook&.id, folder_id: current_folder&.id, note_id: current_note&.id),
          class: "fw-bold text-light m-0 text-decoration-none h5 mb-0", id: "sidebarMenuLabel",
          title: t("home.header.organize"), data: { action: "click->offcanvas#close" } %>
      <div class="d-flex align-items-center">
        <%= link_to todos_path, class: "btn btn-sm btn-outline-secondary border-0 me-1", title: t("home.header.all_open_todos") do %>
          <i class="bi bi-check2-square"></i>
        <% end %>
        <button type="button" class="btn btn-sm btn-outline-secondary border-0 me-1" data-bs-toggle="modal" data-bs-target="#settingsModal" title="<%= t("home.header.settings") %>">
          <i class="bi bi-gear"></i>
        </button>
        <button type="button" class="btn-close btn-close-white d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#sidebarMenu" aria-label="Close"></button>
      </div>
    </div>

    <div class="d-flex flex-column shrink-0" style="max-height: 28vh;">
      <div class="d-flex justify-content-between align-items-center mb-2 shrink-0">
        <p class="text-secondary small mb-0 fw-bold"><%= t("home.notebooks.heading") %></p>
        <%= form_with url: notebooks_path, data: { controller: "prompt-form", prompt_message: t("home.notebooks.new_prompt"), action: "submit->prompt-form#submit" } do |f| %>
          <%= f.hidden_field :name, data: { prompt_form_target: "input" } %>
          <button type="submit" class="btn btn-outline-secondary btn-sm py-0 px-2 fw-bold"><i class="bi bi-plus-lg"></i></button>
        <% end %>
      </div>
      <div id="notebooks-list" data-scroll-id="notebooks" data-controller="scroll" class="overflow-y-auto overflow-x-hidden custom-scrollbar-dark flex-grow-1" style="min-height: 0;">
        <ul class="list-unstyled mb-0 pe-2">
          <% notebooks.each do |notebook| %>
            <li class="hover-container d-flex justify-content-between align-items-center rounded p-1 mb-1 <%= 'bg-secondary text-white' if notebook == current_notebook %>">
              <%= link_to notebook.name, root_path(notebook_id: notebook.id), class: "text-decoration-none text-truncate flex-grow-1 px-1", style: "color: #e0e0e0;" %>

              <div class="d-flex shrink-0">
                <%= link_to export_notebook_path(notebook), class: "hover-target-icon btn btn-sm py-0 px-1 border-0 ms-1", style: "color: #e0e0e0;", title: t("home.notebooks.export") do %>
                  <i class="bi bi-download"></i>
                <% end %>

                <%= form_with url: notebook_path(notebook), method: :patch, data: { controller: "prompt-form", prompt_message: t("home.notebooks.rename_prompt"), action: "submit->prompt-form#submit" }, class: "hover-target-icon ms-1" do |f| %>
                  <%= f.hidden_field :name, value: notebook.name, data: { prompt_form_target: "input" } %>
                  <button type="submit" class="btn btn-sm py-0 px-1 border-0" style="color: #e0e0e0;" title="<%= t("home.common.rename") %>"><i class="bi bi-pencil"></i></button>
                <% end %>

                <%= button_to notebook_path(notebook), method: :delete, data: { turbo_confirm: t("home.notebooks.delete_confirm") }, class: "hover-target-icon btn btn-outline-danger py-0 px-2 ms-1", title: t("home.common.delete") do %>
                  <i class="bi bi-x-lg"></i>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    </div>

    <div class="d-flex flex-column border-top border-secondary pt-3 mt-1 shrink-0" style="max-height: 32vh;">
      <div class="d-flex justify-content-between align-items-center mb-2 shrink-0">
        <p class="text-secondary small mb-0 fw-bold"><%= t("home.folders.heading") %></p>
        <% if current_notebook %>
          <%= form_with url: notebook_folders_path(current_notebook), data: { controller: "prompt-form", prompt_message: t("home.folders.new_prompt"), action: "submit->prompt-form#submit" } do |f| %>
            <%= f.hidden_field :name, data: { prompt_form_target: "input" } %>
            <button type="submit" class="btn btn-outline-secondary btn-sm py-0 px-2 fw-bold"><i class="bi bi-plus-lg"></i></button>
          <% end %>
        <% end %>
      </div>
      <div id="folders-list" data-scroll-id="folders" data-controller="scroll" class="overflow-y-auto overflow-x-hidden custom-scrollbar-dark flex-grow-1" style="min-height: 0;">
        <ul class="list-unstyled mb-0 pe-2">
          <% folders.each do |folder| %>
            <li class="hover-container d-flex justify-content-between align-items-center rounded p-1 mb-1 <%= 'bg-secondary text-white' if folder == current_folder %>">
              <%= link_to folder.name, root_path(notebook_id: current_notebook.id, folder_id: folder.id), class: "text-decoration-none text-truncate flex-grow-1 px-1", style: "color: #e0e0e0;" %>

              <div class="d-flex shrink-0">
                <%= form_with url: notebook_folder_path(folder.notebook, folder), method: :patch, data: { controller: "prompt-form", prompt_message: t("home.folders.rename_prompt"), action: "submit->prompt-form#submit" }, class: "hover-target-icon ms-1" do |f| %>
                  <%= f.hidden_field :name, value: folder.name, data: { prompt_form_target: "input" } %>
                  <button type="submit" class="btn btn-sm py-0 px-1 border-0" style="color: #e0e0e0;" title="<%= t("home.common.rename") %>"><i class="bi bi-pencil"></i></button>
                <% end %>

                <%= button_to notebook_folder_path(folder.notebook, folder), method: :delete, data: { turbo_confirm: t("home.folders.delete_confirm") }, class: "hover-target-icon btn btn-outline-danger py-0 px-2 ms-1", title: t("home.common.delete") do %>
                  <i class="bi bi-x-lg"></i>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    </div>

    <div class="d-flex flex-column border-top border-secondary pt-3 mt-1 flex-grow-1" style="min-height: 0;">
      <div class="d-flex justify-content-between align-items-center mb-2 shrink-0">
        <p class="text-secondary small mb-0 fw-bold"><%= t("home.files.heading") %></p>
      </div>

      <% if current_folder %>
          <div class="d-flex gap-2 mb-2 shrink-0">
            <%= button_to notes_path, params: { folder_id: current_folder.id, note_type: "md" }, class: "btn btn-sm btn-secondary py-1 px-2", title: t("home.files.new_md") do %>
              <i class="bi bi-filetype-md"></i>
            <% end %>
            <%= button_to notes_path, params: { folder_id: current_folder.id, note_type: "todo" }, class: "btn btn-sm btn-secondary py-1 px-2", title: t("home.files.new_todo") do %>
              <i class="bi bi-check2-square"></i>
            <% end %>
            <%= button_to notes_path, params: { folder_id: current_folder.id, note_type: "scrap" }, class: "btn btn-sm btn-secondary py-1 px-2", title: t("home.files.new_scrap") do %>
              <i class="bi bi-pin-angle"></i>
            <% end %>
          </div>
      <% end %>

      <div class="d-flex flex-column flex-grow-1" data-controller="note-sort" style="min-height: 0;">
        <!-- Client-side only, not persisted — see ux-roadmap.md.old's "Note list sorting". -->
        <div class="d-flex gap-1 mb-2 shrink-0">
          <%# The U/C/A-Z labels themselves stay locale-invariant — compact,
              icon-like abbreviations rather than translatable prose — only
              their tooltips are. %>
          <button type="button" class="btn btn-sm btn-outline-secondary flex-fill py-0" data-note-sort-target="button" data-mode="updated" data-action="click->note-sort#setMode" title="<%= t("home.sort.updated") %>">
            U <i class="bi" data-note-sort-target="caret"></i>
          </button>
          <button type="button" class="btn btn-sm btn-outline-secondary flex-fill py-0" data-note-sort-target="button" data-mode="created" data-action="click->note-sort#setMode" title="<%= t("home.sort.created") %>">
            C <i class="bi" data-note-sort-target="caret"></i>
          </button>
          <button type="button" class="btn btn-sm btn-outline-secondary flex-fill py-0" data-note-sort-target="button" data-mode="title" data-action="click->note-sort#setMode" title="<%= t("home.sort.title") %>">
            A-Z <i class="bi" data-note-sort-target="caret"></i>
          </button>
        </div>

        <div id="notes-list" data-scroll-id="notes" data-controller="scroll" class="overflow-y-auto overflow-x-hidden custom-scrollbar-dark flex-grow-1" style="min-height: 0;">
          <ul class="list-unstyled mb-0 pe-2" data-note-sort-target="list">
            <% notes.each do |note| %>
              <li class="hover-container d-flex justify-content-between align-items-center border-bottom border-secondary hover-bg-secondary <%= 'bg-secondary text-white' if note == current_note %>"
                  data-note-sort-target="item"
                  data-pinned="<%= note.is_pinned? %>"
                  data-updated-at="<%= note.updated_at.to_i %>"
                  data-created-at="<%= note.created_at.to_i %>"
                  data-title="<%= note.title.downcase %>">
                <%= link_to root_path(notebook_id: current_notebook&.id, folder_id: current_folder&.id, note_id: note.id),
                    class: "text-decoration-none p-2 flex-grow-1 text-truncate",
                    style: "color: #e0e0e0;",
                    data: { turbo_frame: "_top", action: "click->offcanvas#close" } do %>

                  <i class="bi <%= note_icon_class(note) %> me-2 opacity-75"></i>
                  <span id="note_<%= note.id %>_title"><%= note.title %></span>

                <% end %>
                <div class="d-flex shrink-0 align-items-center">
                  <button type="button" class="hover-target-icon btn btn-sm py-0 px-1 border-0 <%= 'pin-active' if note.is_pinned? %>"
                      style="color: #e0e0e0;" title="<%= t("home.notes.pin") %>" data-note-id="<%= note.id %>" data-action="click->note-sort#togglePin">
                    <i class="bi <%= note.is_pinned? ? 'bi-pin-fill' : 'bi-pin' %>"></i>
                  </button>
                  <%= link_to export_note_path(note), class: "hover-target-icon btn btn-sm py-0 px-1 border-0", style: "color: #e0e0e0;", title: t("home.notes.export") do %>
                    <i class="bi bi-download"></i>
                  <% end %>
                  <%= button_to note_path(note), method: :delete, data: { turbo_confirm: t("home.notes.delete_confirm") }, class: "hover-target-icon btn btn-outline-danger py-0 px-2 shrink-0", title: t("home.common.delete"), form: { class: "d-inline" } do %>
                    <i class="bi bi-x-lg"></i>
                  <% end %>
                </div>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>
