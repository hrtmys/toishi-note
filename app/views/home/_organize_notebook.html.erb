<li class="mb-2" id="organize_notebook_<%= notebook.id %>" data-notebook-id="<%= notebook.id %>">
  <div class="d-flex align-items-center p-2 bg-white rounded shadow-sm border">
    <i class="bi bi-grip-vertical me-2 text-muted organize-drag-handle" style="cursor: grab;"></i>
    <i class="bi bi-journal-text me-2"></i>
    <span class="fw-bold text-truncate flex-grow-1"><%= notebook.name %></span>

    <div class="d-flex shrink-0 ms-2">
      <%= form_with url: notebook_folders_path(notebook),
          data: { controller: "prompt-form", prompt_message: t("home.folders.new_prompt"), action: "submit->prompt-form#submit" }, class: "d-inline" do |f| %>
        <%= f.hidden_field :name, data: { prompt_form_target: "input" } %>
        <%= organize_context_fields %>
        <button type="submit" class="btn btn-sm py-0 px-1 border-0" title="<%= t("home.folders.new_prompt") %>"><i class="bi bi-plus-lg"></i></button>
      <% end %>

      <%= form_with url: notebook_path(notebook), method: :patch,
          data: { controller: "prompt-form", prompt_message: t("home.notebooks.rename_prompt"), action: "submit->prompt-form#submit" }, class: "d-inline" do |f| %>
        <%= f.hidden_field :name, value: notebook.name, data: { prompt_form_target: "input" } %>
        <%= organize_context_fields %>
        <button type="submit" class="btn btn-sm py-0 px-1 border-0" title="<%= t("home.common.rename") %>"><i class="bi bi-pencil"></i></button>
      <% end %>

      <%= form_with url: notebook_path(notebook), method: :delete,
          data: { turbo_confirm: t("home.notebooks.delete_confirm") }, class: "d-inline" do %>
        <%= organize_context_fields %>
        <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-1" title="<%= t("home.common.delete") %>"><i class="bi bi-x-lg"></i></button>
      <% end %>
    </div>
  </div>

  <%# Always rendered, even with zero folders — SortableJS needs a real
      droppable container to accept a folder dragged in from another
      notebook; an empty notebook would otherwise have nowhere for one to land. %>
  <ul class="list-unstyled ms-4 mt-1 mb-0" style="min-height: 0.5rem;"
      data-organize-target="folderList" data-notebook-id="<%= notebook.id %>">
    <% notebook.folders.each do |folder| %>
      <%= render "home/organize_folder", folder: folder %>
    <% end %>
  </ul>
</li>
