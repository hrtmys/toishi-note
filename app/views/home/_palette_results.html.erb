<ul class="list-unstyled mb-0 custom-scrollbar-light overflow-y-auto" style="max-height: 60vh;" data-palette-target="list">
  <% if notes.empty? %>
    <li class="p-3 text-muted small">
      <%= query.present? ? t("palette.no_results") : t("palette.empty") %>
    </li>
  <% else %>
    <%# On the blank-query MRU list, the second entry (index 1) — the note
        the user was just in, one hop back from whichever note is open
        right now — starts preselected, so Ctrl+P -> Enter alternates
        between the two most recently viewed notes with no second
        shortcut to learn. A search result list never preselects this
        way; the top match does instead. %>
    <% preselected_index = query.blank? && notes.size > 1 ? 1 : 0 %>
    <% notes.each_with_index do |note, index| %>
      <li class="palette-result px-3 py-2 border-bottom <%= "palette-result-selected" if index == preselected_index %>"
          data-palette-target="item"
          data-action="click->palette#select"
          data-url="<%= root_path(notebook_id: note.notebook_id, folder_id: note.folder_id, note_id: note.id) %>">
        <div class="fw-medium text-truncate"><%= note.title %></div>
        <div class="small text-muted text-truncate"><%= note.notebook.name %> › <%= note.folder.name %></div>
      </li>
    <% end %>
  <% end %>
</ul>
