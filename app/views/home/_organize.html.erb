<%# The Organize view — a third mode of the main pane (see index.html.erb's
    `if @organize` branch), not a modal: entering/leaving is a normal
    navigation, so there's no "stay open" state to protect and no risk of
    the sidebar going stale, unlike everything nested inside
    turbo_frame_tag "main_editor" (see the comment there). %>
<div class="h-100 d-flex flex-column overflow-hidden p-4" data-controller="organize">
  <div class="d-flex justify-content-between align-items-center border-bottom mb-3 pb-2 shrink-0">
    <h2 class="h4 fw-bold mb-0"><%= t("home.organize.heading") %></h2>
    <%= link_to t("home.organize.back"), root_path(notebook_id: @current_notebook&.id, folder_id: @current_folder&.id, note_id: @current_note&.id),
        class: "btn btn-outline-secondary" %>
  </div>

  <%= form_with url: notebooks_path, class: "mb-3 shrink-0",
      data: { controller: "prompt-form", prompt_message: t("home.notebooks.new_prompt"), action: "submit->prompt-form#submit" } do |f| %>
    <%= f.hidden_field :name, data: { prompt_form_target: "input" } %>
    <%= organize_context_fields %>
    <button type="submit" class="btn btn-outline-secondary btn-sm"><i class="bi bi-plus-lg"></i> <%= t("home.notebooks.new_prompt") %></button>
  <% end %>

  <div class="flex-grow-1 overflow-y-auto custom-scrollbar-light">
    <% if notebooks.any? %>
      <ul class="list-unstyled mb-0" id="organize-notebooks-tree" data-organize-target="notebookList">
        <% notebooks.each do |notebook| %>
          <%= render "home/organize_notebook", notebook: notebook %>
        <% end %>
      </ul>
    <% else %>
      <p class="text-muted"><%= t("home.organize.empty") %></p>
    <% end %>
  </div>
</div>
